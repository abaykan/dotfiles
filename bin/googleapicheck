#!/usr/bin/env python3
"""Google API Key Security Scanner"""

import requests
import warnings
import json
import sys
import time

warnings.filterwarnings("ignore")

def scan(key):
    banner = """       .-.      _______  
      {}``; |==|_______D 
      / ('        /|\     Google API Key 
  (  /  |        / | \       Checker
  \(_)_]]      /  |  \  
          github.com/abaykan
"""
    tests = [
        ("Custom Search",    "GET",  f"https://www.googleapis.com/customsearch/v1?cx=017576662512468239146:omuauf_lfve&q=lectures&key={key}", lambda r: "errors" not in r.text),
        ("Static Map",       "GET",  f"https://maps.googleapis.com/maps/api/staticmap?center=45%2C10&zoom=7&size=400x400&key={key}", lambda r: r.status_code == 200),
        ("Street View",      "GET",  f"https://maps.googleapis.com/maps/api/streetview?size=400x400&location=40.720032,-73.988354&fov=90&key={key}", lambda r: r.status_code == 200),
        ("Directions",       "GET",  f"https://maps.googleapis.com/maps/api/directions/json?origin=Disneyland&destination=Universal+Studios&key={key}", lambda r: "error_message" not in r.text),
        ("Geocoding",        "GET",  f"https://maps.googleapis.com/maps/api/geocode/json?latlng=40,30&key={key}", lambda r: "error_message" not in r.text),
        ("Distance Matrix",  "GET",  f"https://maps.googleapis.com/maps/api/distancematrix/json?units=imperial&origins=40.665,-73.891&destinations=40.690,-73.997&key={key}", lambda r: "error_message" not in r.text),
        ("Find Place",       "GET",  f"https://maps.googleapis.com/maps/api/place/findplacefromtext/json?input=Museum+Australia&inputtype=textquery&fields=name&key={key}", lambda r: "error_message" not in r.text),
        ("Autocomplete",     "GET",  f"https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Bingh&types=%28cities%29&key={key}", lambda r: "error_message" not in r.text),
        ("Elevation",        "GET",  f"https://maps.googleapis.com/maps/api/elevation/json?locations=39.739,-104.984&key={key}", lambda r: "error_message" not in r.text),
        ("Timezone",         "GET",  f"https://maps.googleapis.com/maps/api/timezone/json?location=39.603,-119.682&timestamp=1331161200&key={key}", lambda r: "errorMessage" not in r.text),
        ("Nearest Roads",    "GET",  f"https://roads.googleapis.com/v1/nearestRoads?points=60.170,24.942|60.170,24.942&key={key}", lambda r: "error" not in r.text),
        ("Geolocation",      "POST", f"https://www.googleapis.com/geolocation/v1/geolocate?key={key}", lambda r: "error" not in r.text, {"json": {"considerIp": "true"}}),
        ("Snap to Roads",    "GET",  f"https://roads.googleapis.com/v1/snapToRoads?path=-35.278,149.129|-35.280,149.129&interpolate=true&key={key}", lambda r: "error" not in r.text),
        ("Speed Limit",      "GET",  f"https://roads.googleapis.com/v1/speedLimits?path=38.758,-9.037&key={key}", lambda r: "error" not in r.text),
        ("Place Details",    "GET",  f"https://maps.googleapis.com/maps/api/place/details/json?place_id=ChIJN1t_tDeuEmsRUsoyG83frY4&fields=name&key={key}", lambda r: "error_message" not in r.text),
        ("Nearby Search",    "GET",  f"https://maps.googleapis.com/maps/api/place/nearbysearch/json?location=-33.867,151.195&radius=100&types=food&key={key}", lambda r: "error_message" not in r.text),
        ("Text Search",      "GET",  f"https://maps.googleapis.com/maps/api/place/textsearch/json?query=restaurants+in+Sydney&key={key}", lambda r: "error_message" not in r.text),
        ("Places Photo",     "GET",  f"https://maps.googleapis.com/maps/api/place/photo?maxwidth=400&photoreference=CnRtAAAATLZNl354RwP_9UKbQ_5Psy40texXePv4oAlgP4qNEkdIrkyse7rPXYGd9D&key={key}", lambda r: r.status_code == 302, {"allow_redirects": False}),
        ("FCM",              "POST", "https://fcm.googleapis.com/fcm/send", lambda r: r.status_code == 200, {"json": {"registration_ids": ["ABC"]}, "headers": {"Content-Type": "application/json", "Authorization": f"key={key}"}}),
    ]

    vulns = []
    total = len(tests)
    masked = key[:8] + "*" * (len(key) - 12) + key[-4:]

    print()
    print(banner)
    print("Google API Key Scanner")
    print("-" * 40)
    print(f"key:   {masked}")
    print(f"len:   {len(key)} chars")
    print("-" * 40)
    print()

    for i, (name, method, url, check, *extra) in enumerate(tests, 1):
        extra = extra[0] if extra else {}
        sys.stdout.write(f"\r[{i}/{total}] {name:<20}")
        sys.stdout.flush()

        try:
            if method == "POST":
                r = requests.post(url, verify=False, timeout=10, **extra)
            else:
                r = requests.get(url, verify=False, timeout=10, **extra)

            is_vuln = check(r)
            label = "VULN" if is_vuln else "NOT VULN"
            sys.stdout.write(f"\r[{i}/{total}] {name:<20} {label}\n")

            if is_vuln:
                vulns.append(name)
        except:
            sys.stdout.write(f"\r[{i}/{total}] {name:<20} err\n")

        time.sleep(0.05)

    print()
    print("-" * 40)
    if vulns:
        print(f"{len(vulns)} vulnerable API(s) found:")
        print()
        for name in vulns:
            print(f"  * {name}")
    else:
        print("all clean, 0 vulnerable APIs")
    print()
    print("pricing: https://cloud.google.com/maps-platform/pricing")
    print("-" * 40)
    print()

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help"]:
        print("usage: googleapicheck <API_KEY>")
        sys.exit(0 if sys.argv[1:] else 1)

    scan(sys.argv[1])

if __name__ == "__main__":
    main()
