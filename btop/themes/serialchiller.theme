# serialchiller - btop theme matching kitty VSCode_Dark palette
# ported from ~/.config/kitty/current-theme.conf

# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255"

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1e1e1e"

# Main text color
theme[main_fg]="#cccccc"

# Title color for boxes
theme[title]="#3b8eea"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#29b8db"

# Background color of selected item in processes box
theme[selected_bg]="#264f78"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#666666"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#29b8db"

# Cpu box outline color
theme[cpu_box]="#414140"

# Memory/disks box outline color
theme[mem_box]="#414140"

# Net up/down box outline color
theme[net_box]="#414140"

# Processes box outline color
theme[proc_box]="#414140"

# Box divider line and small boxes line color
theme[div_line]="#414140"

# Temperature graph colors
theme[temp_start]="#3b8eea"
theme[temp_mid]="#f5f543"
theme[temp_end]="#f14c4c"

# CPU graph colors
theme[cpu_start]="#0dbc79"
theme[cpu_mid]="#23d18b"
theme[cpu_end]="#f5f543"

# Mem/Disk free meter
theme[free_start]="#2472c8"
theme[free_mid]="#3b8eea"
theme[free_end]="#29b8db"

# Mem/Disk cached meter
theme[cached_start]="#11a8cd"
theme[cached_mid]="#29b8db"
theme[cached_end]="#e5e5e5"

# Mem/Disk available meter
theme[available_start]="#0dbc79"
theme[available_mid]="#23d18b"
theme[available_end]="#e5e5e5"

# Mem/Disk used meter
theme[used_start]="#bc3fbc"
theme[used_mid]="#d670d6"
theme[used_end]="#f14c4c"

# Download graph colors
theme[download_start]="#2472c8"
theme[download_mid]="#3b8eea"
theme[download_end]="#29b8db"

# Upload graph colors
theme[upload_start]="#bc3fbc"
theme[upload_mid]="#d670d6"
theme[upload_end]="#f5f543"
